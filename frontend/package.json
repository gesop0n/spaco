    "@hookform/resolvers": "^5.9.1",
    "@supabase/auth-js": "^2.115.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
